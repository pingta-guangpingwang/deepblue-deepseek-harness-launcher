{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitee.com/wanggp123/deepseek-harness-skins/raw/master/schema/catalog.schema.json",
  "title": "DeepSeekHarness signed skin catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["keyId", "algorithm", "payload", "signature"],
  "properties": {
    "keyId": { "type": "string", "minLength": 1 },
    "algorithm": { "const": "ed25519" },
    "signature": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "pageSize", "items"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "pageSize": { "const": 20 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/skin" } }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size", "mime"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 83886080 },
        "mime": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif", "video/mp4", "video/webm"] }
      }
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "mediaKind", "styles", "tags", "featured", "contentRating", "thumbnail", "media", "license", "presentation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "mediaKind": { "enum": ["image", "animated-image", "video"] },
        "styles": { "type": "array", "items": { "enum": ["realistic", "anime", "cyber", "pixel", "nature", "minimal"] }, "minItems": 1, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "featured": { "type": "boolean" },
        "contentRating": { "const": "everyone" },
        "thumbnail": { "$ref": "#/$defs/asset" },
        "media": { "$ref": "#/$defs/asset" },
        "poster": { "$ref": "#/$defs/asset" },
        "sourceKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{2,80}$" },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "author", "sourceUrl"],
          "properties": {
            "name": { "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "MIT", "GPL-2.0", "GPL-3.0", "UNDECLARED"] },
            "url": { "type": "string", "format": "uri" },
            "author": { "type": "string", "minLength": 1 },
            "sourceUrl": { "type": "string", "format": "uri" },
            "attribution": { "type": "string" }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "overlay", "blurPx", "surfaceOpacity"],
          "properties": {
            "position": { "type": "string", "pattern": "^[0-9]{1,3}% [0-9]{1,3}%$" },
            "overlay": { "type": "string", "pattern": "^rgba\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}, (0|1|0?\\.[0-9]+)\\)$" },
            "blurPx": { "type": "number", "minimum": 0, "maximum": 24 },
            "surfaceOpacity": { "type": "number", "minimum": 0.2, "maximum": 0.98 }
          }
        }
      }
    }
  }
}
